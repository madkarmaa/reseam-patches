root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4
max_line_length = 100

[*.java]
ij_java_continuation_indent_size = 8
ij_java_right_margin = 100

[{*.kt,*.kts}]
ij_kotlin_continuation_indent_size = 4
ij_kotlin_right_margin = 100
