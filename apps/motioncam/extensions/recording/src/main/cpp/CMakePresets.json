{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "android",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/../../../../../patch/src/main/resources/lib",
            "toolchainFile": "${sourceDir}/ndk.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_static",
                "CMAKE_BUILD_TYPE": "Release"
            },
            "hidden": true
        },
        {
            "name": "arm64-v8a",
            "inherits": "android",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64-v8a",
            "configurePreset": "arm64-v8a",
            "targets": [
                "install"
            ]
        }
    ]
}
