# CLion's default check groups, minus checks that contradict what this library must do:
# - cert-dcl50-cpp, cppcoreguidelines-pro-type-vararg: the proxies match libc's variadic open().
# - modernize-avoid-variadic-functions: the same required libc and Android logging ABI.
# - portability-avoid-pragma-once: all four Android NDK targets support this header convention.
# - cppcoreguidelines-pro-bounds-array-to-pointer-decay: va_list is an array type on x86_64.
# - cppcoreguidelines-avoid-non-const-global-variables: hook and signal state is process-wide,
#   since libc proxies and signal handlers receive no context.
# - cppcoreguidelines-pro-type-static-cast-downcast: JNI handles are downcast by design.
# - cppcoreguidelines-pro-type-union-access: siginfo_t exposes its fields through unions.
# - cppcoreguidelines-owning-memory: ownership uses std::unique_ptr, without the GSL.
# - google-runtime-int, performance-no-int-to-ptr: syscall arguments, results and saved registers
#   are long integers by the kernel ABI.
# - misc-include-cleaner: it has no mappings for bionic's internal headers.
# - misc-misplaced-const: const JNI handle parameters deliberately make the handle const.
# - readability-braces-around-statements: single-statement guards stay without braces.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-dcl50-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  google-*,
  -google-readability-*,
  -google-runtime-int,
  misc-*,
  -misc-include-cleaner,
  -misc-misplaced-const,
  -misc-unused-parameters,
  modernize-*,
  -modernize-avoid-variadic-functions,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-no-int-to-ptr,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-magic-numbers
CheckOptions:
  # Pointers that are never reassigned are const too, as the IDE suggests.
  misc-const-correctness.WarnPointersAsValues: true
  # The logging macros use the standard do-while(false) statement wrapper.
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  readability-function-cognitive-complexity.IgnoreMacros: true
